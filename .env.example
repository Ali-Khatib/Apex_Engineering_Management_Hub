# Copy to .env in the project root and fill in. Never commit the filled copy.
# Docker Compose reads the root .env for both the db and app services.
POSTGRES_USER=apex
POSTGRES_PASSWORD=change-me          # required; compose refuses to start without it
POSTGRES_DB=apex_erp
APEX_ENV=development                 # "production" enables the safety rails

# Backend settings
JWT_SECRET=                          # required when APEX_ENV=production
GITHUB_WEBHOOK_SECRET=               # required when APEX_ENV=production
GITHUB_TOKEN=                        # optional; enables live REST sync
ALLOW_SIMULATED_GITHUB=0             # 1 enables fabricated activity; ignored in production
APEX_AUTO_MIGRATE=0                  # 1 runs alembic upgrade head at startup; set for a first run or one deliberate deploy
APEX_REQUIRE_COMPLIANCE_REVIEW=0       # 1: a component needs a human-approved compliance review before it can be marked done or deployed
