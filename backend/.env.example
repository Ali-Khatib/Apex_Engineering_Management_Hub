# Copy to .env and fill in. Never commit the filled copy.
APEX_ENV=development                 # set to "production" to enable the rails
DATABASE_URL=postgresql+psycopg2://apex:apex@localhost:5432/apex_erp
JWT_SECRET=                          # required when APEX_ENV=production
GITHUB_WEBHOOK_SECRET=               # required when APEX_ENV=production
GITHUB_TOKEN=                        # optional; enables live REST sync
ALLOW_SIMULATED_GITHUB=0             # 1 enables fabricated activity; ignored in production
APEX_AUTO_MIGRATE=0                  # 1 runs alembic upgrade head at startup. Set it for a first local run or one deliberate deploy, then back to 0
